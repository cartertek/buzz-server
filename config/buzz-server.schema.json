{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.example/schemas/buzz-server-config.json",
  "title": "Buzz Server configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_database",
    "log_directory",
    "working_directory",
    "owner_secret_file",
    "signer_conditions",
    "runtime_catalog",
    "harness",
    "restart",
    "health"
  ],
  "properties": {
    "state_database": {
      "type": "string",
      "pattern": "^/var/lib/buzz-server(?:/|$)"
    },
    "log_directory": {
      "type": "string",
      "pattern": "^/var/log/buzz-server(?:/|$)"
    },
    "working_directory": {
      "type": "string",
      "pattern": "^/var/lib/buzz-server(?:/|$)"
    },
    "owner_secret_file": {
      "const": "/run/buzz-server/credentials/owner-secret"
    },
    "signer_conditions": {
      "type": "string"
    },
    "runtime_catalog": {
      "type": "object"
    },
    "harness": {
      "type": "object"
    },
    "harness_arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restart": {
      "type": "object"
    },
    "health": {
      "type": "object"
    },
    "lifecycle_api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unix_socket": {
          "type": "string",
          "pattern": "^/run/buzz-server(?:/|$)"
        },
        "administrator_uids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "draft_submitter_uids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "tls": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
