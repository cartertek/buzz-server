[Unit]
Description=Buzz Server agent lifecycle service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=buzz-server
SupplementaryGroups=buzz-agent
ExecStartPre=+/opt/buzz-server/current/share/deploy/prepare-community-identities.sh
ExecStartPre=+/usr/bin/install -d -o buzz-server -g buzz-agent -m 0710 /var/lib/buzz-server/runtime
ExecStartPre=+/usr/bin/install -d -o root -g buzz-agent -m 0710 /var/lib/buzz-server/agents
ExecStart=/opt/buzz-server/current/buzz-server run --config /etc/buzz-server/config.json
EnvironmentFile=/etc/buzz-server/secrets.env
UnsetEnvironment=BUZZ_OWNER_SECRET AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
StateDirectory=buzz-server
StateDirectoryMode=0755
RuntimeDirectory=buzz-server
RuntimeDirectoryMode=0700
LogsDirectory=buzz-server
LogsDirectoryMode=0700
UMask=0077
PrivateTmp=true
PrivateDevices=false
ProtectClock=true
ProtectControlGroups=false
ProtectKernelLogs=true
ProtectKernelModules=true
# Managed harnesses may create their own nested sandbox (for example Codex's
# bubblewrap workspace sandbox), which needs UID maps under /proc/sys.
ProtectKernelTunables=false
ProtectProc=default
ProcSubset=all
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Match Desktop's ability to let a harness create its own user/mount/network
# namespaces while retaining the remaining service hardening below.
RestrictNamespaces=false
RestrictRealtime=true
RestrictSUIDSGID=false
LockPersonality=true
SystemCallArchitectures=native
# The daemon owns every managed harness and its ACP worker pool. A single
# configured agent may intentionally run many Codex workers, each with several
# threads, so the service-wide task ceiling must leave substantial headroom.
TasksMax=30%
LimitNOFILE=8192
MemoryMax=4G

[Install]
WantedBy=multi-user.target
