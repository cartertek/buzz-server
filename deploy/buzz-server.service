[Unit]
Description=Buzz Server development daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=buzz-server
ExecStart=/opt/buzz-server/current/buzz-server --config /etc/buzz-server/config.json
EnvironmentFile=/etc/buzz-server/secrets.env
LoadCredential=owner-secret:/etc/buzz-server/owner-secret
UnsetEnvironment=BUZZ_OWNER_SECRET
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# The daemon deliberately leaves an adopted agent running across a planned
# Buzz Server restart. Killing only the main process lets the replacement
# daemon validate the persisted receipt and adopt that exact child PID.
KillMode=process
StateDirectory=buzz-server
StateDirectoryMode=0755
RuntimeDirectory=buzz-server
RuntimeDirectoryMode=0700
LogsDirectory=buzz-server
LogsDirectoryMode=0700
ExecStartPre=+/usr/bin/install -d -o buzz-agent -g buzz-agent -m 0700 /var/lib/buzz-server/workspaces /var/lib/buzz-server/runtime
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/buzz-server /run/buzz-server /var/log/buzz-server
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
