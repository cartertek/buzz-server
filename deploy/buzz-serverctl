#!/bin/sh
set -eu

command=${1:-}
case "$command" in
  health)
    systemctl is-active --quiet buzz-server.service
    test -f /var/lib/buzz-server/state.sqlite3
    echo healthy
    ;;
  start) systemctl start buzz-server.service ;;
  restart) systemctl restart buzz-server.service ;;
  stop) systemctl stop buzz-server.service ;;
  status) systemctl status --no-pager buzz-server.service ;;
  redeploy)
    [ "$#" -ge 3 ] && [ "$#" -le 4 ] || { echo "usage: buzz-serverctl redeploy VERSION TARGET [OWNER/REPOSITORY]" >&2; exit 64; }
    exec /usr/libexec/buzz-server/install-release.sh "$2" "$3" "${4:-cartertek/buzz-server}"
    ;;
  backup)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { echo "usage: buzz-serverctl backup OUTPUT [KMS_KEY_ID]" >&2; exit 64; }
    exec /opt/buzz-server/current/share/deploy/backup.sh "$2" "${3:-}"
    ;;
  restore)
    [ "$#" -eq 2 ] || { echo "usage: buzz-serverctl restore BACKUP" >&2; exit 64; }
    exec /opt/buzz-server/current/share/deploy/restore.sh "$2"
    ;;
  check)
    exec /opt/buzz-server/current/share/deploy/healthcheck.sh
    ;;
  rollback)
    [ "$#" -eq 2 ] || { echo "usage: buzz-serverctl rollback VERSION" >&2; exit 64; }
    case "$2" in *[!A-Za-z0-9._-]*|'') echo "invalid version" >&2; exit 64;; esac
    target="/opt/buzz-server/releases/$2"
    test -x "$target/buzz-server"
    test -f "$target/share/deploy/buzz-server.service"
    test -x "$target/share/deploy/buzz-serverctl"
    previous=$(readlink -f /opt/buzz-server/current)
    test -x "$previous/buzz-server"
    unit_backup=$(mktemp)
    trap 'rm -f "$unit_backup"' EXIT HUP INT TERM
    cp -L /etc/systemd/system/buzz-server.service "$unit_backup"
    ln -sfn "$target" /opt/buzz-server/current.next
    mv -Tf /opt/buzz-server/current.next /opt/buzz-server/current
    install -o root -g root -m 0444 "$target/share/deploy/buzz-server.service" /etc/systemd/system/buzz-server.service
    systemctl daemon-reload
    systemctl restart buzz-server.service
    wait_for_health() {
      controller=$1
      attempts=0
      while [ "$attempts" -lt 90 ]; do
        if "$controller" health >/dev/null 2>&1; then return 0; fi
        attempts=$((attempts + 1))
        sleep 1
      done
      return 1
    }
    if ! wait_for_health "$target/share/deploy/buzz-serverctl"; then
      ln -sfn "$previous" /opt/buzz-server/current.next
      mv -Tf /opt/buzz-server/current.next /opt/buzz-server/current
      install -o root -g root -m 0444 "$unit_backup" /etc/systemd/system/buzz-server.service
      systemctl daemon-reload
      if ! systemctl restart buzz-server.service || ! wait_for_health "$previous/share/deploy/buzz-serverctl"; then
        echo "rollback target and previous release both failed health checks" >&2
        exit 1
      fi
      echo "rollback target failed health checks; previous release restored" >&2
      exit 1
    fi
    ;;
  *)
    echo "usage: buzz-serverctl {health|check|start|restart|stop|status|redeploy|rollback|backup|restore}" >&2
    exit 64
    ;;
esac
