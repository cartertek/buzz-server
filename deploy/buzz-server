#!/bin/sh
set -eu

identity='@BUZZ_SERVER_IDENTITY@'

self=$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")
release=$(dirname "$self")
if [ ! -x "$release/buzz-server-daemon" ]; then
  release=/opt/buzz-server/current
fi

help() {
  cat <<'EOF_HELP'
Buzz Server

Usage:
  buzz-server <command> [options]

Commands:
  run            Run the Buzz Server daemon
  health         Check whether Buzz Server is healthy
  check          Run the host health check
  start          Start the system service
  restart        Restart the system service
  stop           Stop the system service
  status         Show service status
  redeploy       Deploy a release by version and target
  rollback       Roll back to an installed release
  backup         Back up Buzz Server state
  restore        Restore a backup
  communities    Manage Buzz communities
  agents         Manage agent identities and hosted agents
  channels       Manage Buzz channels
  secrets        Manage secrets
  version        Show the installed version

Options:
  -h, --help     Show this help
  -V, --version  Show the installed version

Run `buzz-server <command> --help` for command-specific help.
EOF_HELP
}

command_help() {
  case "$1" in
    run)          printf '%s\n' 'Usage: buzz-server run --config FILE' 'Run the Buzz Server daemon using FILE as its configuration.' ;;
    health)       printf '%s\n' 'Usage: buzz-server health' 'Check the service, signer readiness, and state database.' ;;
    check)        printf '%s\n' 'Usage: buzz-server check' 'Run the host health check and update health metrics.' ;;
    start)        printf '%s\n' 'Usage: buzz-server start' 'Start the Buzz Server system service.' ;;
    restart)      printf '%s\n' 'Usage: buzz-server restart' 'Restart the Buzz Server system service.' ;;
    stop)         printf '%s\n' 'Usage: buzz-server stop' 'Stop the Buzz Server system service.' ;;
    status)       printf '%s\n' 'Usage: buzz-server status' 'Show the Buzz Server system service status.' ;;
    redeploy)     printf '%s\n' 'Usage: buzz-server redeploy VERSION TARGET [OWNER/REPOSITORY]' 'Deploy an immutable release by version and Linux target.' ;;
    rollback)     printf '%s\n' 'Usage: buzz-server rollback VERSION' 'Switch atomically to an already installed release.' ;;
    backup)       printf '%s\n' 'Usage: buzz-server backup OUTPUT [KMS_KEY_ID]' 'Write a backup to OUTPUT, optionally encrypted with AWS KMS.' ;;
    restore)      printf '%s\n' 'Usage: buzz-server restore BACKUP' 'Restore Buzz Server state from BACKUP.' ;;
    version)      printf '%s\n' 'Usage: buzz-server version' 'Show the installed Buzz Server version.' ;;
    communities)  communities_help ;;
    personas)     personas_help ;;
    agents)       agents_help ;;
    channels)     channels_help ;;
    secrets)      secrets_help ;;
    *) return 1 ;;
  esac
}

communities_help() {
  cat <<'EOF_HELP'
Usage: buzz-server communities <command> [options]

Commands:
  join           Join an existing community
  get            Get a community
  list           List communities
  update         Update a community
  delete         Delete a community

Run `buzz-server communities <command> --help` for command-specific help.
EOF_HELP
}

communities_command_help() {
  case "$1" in
    join)   printf '%s\n' 'Usage: buzz-server communities join --display-name NAME --relay-url URL [--secret-file FILE]' 'Without --secret-file, the Nostr private key is read from a hidden terminal prompt.' ;;
    get)    printf '%s\n' 'Usage: buzz-server communities get --community ID' ;;
    list)   printf '%s\n' 'Usage: buzz-server communities list' ;;
    update) printf '%s\n' 'Usage: buzz-server communities update --community ID --display-name NAME' ;;
    delete) printf '%s\n' 'Usage: buzz-server communities delete --community ID' ;;
    *) return 1 ;;
  esac
}


personas_help() {
  cat <<'EOF_HELP'
Usage: buzz-server personas <command> [options]

Commands:
  create         Create a persona
  get            Get a persona
  list           List personas
  update         Update a persona
  delete         Delete a persona

Persona files remain the full editing surface; these commands cover the common fields.
EOF_HELP
}

personas_command_help() {
  case "$1" in
    create) printf '%s\n' 'Usage: buzz-server personas create --display-name NAME [--system-prompt PROMPT] [--runtime ID]' ;;
    get)    printf '%s\n' 'Usage: buzz-server personas get --persona ID' ;;
    list)   printf '%s\n' 'Usage: buzz-server personas list' ;;
    update) printf '%s\n' 'Usage: buzz-server personas update --persona ID [--display-name NAME] [--system-prompt PROMPT] [--runtime ID]' ;;
    delete) printf '%s\n' 'Usage: buzz-server personas delete --persona ID' ;;
    *) return 1 ;;
  esac
}

agents_help() {
  cat <<'EOF_HELP'
Usage: buzz-server agents <command> [options]

Hosted-agent commands:
  create         Create and start an agent
  get            Get an agent
  list           List agents
  update         Update an agent
  enable         Enable an agent
  disable        Disable an agent
  logs           Read agent logs
  delete         Recoverably delete an agent
  purge          Permanently purge an agent
  operation      Get a durable operation
  pubkey         Show an agent Nostr public key

Buzz identity commands:
  draft-create   Send an owner-reviewed create request through Buzz
  draft-update   Send an owner-reviewed update request through Buzz
  archive        Archive an agent identity
  unarchive      Unarchive an agent identity
  archived       List archived identities

Run `buzz-server agents <command> --help` for command-specific help.
EOF_HELP
}

agents_command_help() {
  case "$1" in
    create)       printf '%s\n' 'Usage: buzz-server agents create --community ID --display-name NAME [--persona ID | --system-prompt PROMPT] [--runtime ID] [--idempotency KEY] [--correlation ID]' 'A persona-backed agent gets its system prompt from the persona.' ;;
    get)          printf '%s\n' 'Usage: buzz-server agents get --agent ID' ;;
    list)         printf '%s\n' 'Usage: buzz-server agents list [--community ID] [--include-deleted]' ;;
    update)       printf '%s\n' 'Usage: buzz-server agents update --agent ID [--display-name NAME] [--system-prompt PROMPT] [--runtime ID] [--idempotency KEY] [--correlation ID]' ;;
    enable)       printf '%s\n' 'Usage: buzz-server agents enable --agent ID [--idempotency KEY] [--correlation ID]' ;;
    disable)      printf '%s\n' 'Usage: buzz-server agents disable --agent ID [--idempotency KEY] [--correlation ID]' ;;
    logs)         printf '%s\n' 'Usage: buzz-server agents logs --agent ID [--after CURSOR] [--limit N]' ;;
    delete)       printf '%s\n' 'Usage: buzz-server agents delete --agent ID [--idempotency KEY] [--correlation ID]' ;;
    purge)        printf '%s\n' 'Usage: buzz-server agents purge --agent ID [--idempotency KEY] [--correlation ID]' ;;
    operation)    printf '%s\n' 'Usage: buzz-server agents operation --operation ID' ;;
    pubkey)       printf '%s\n' 'Usage: sudo buzz-server agents pubkey --agent ID' 'Show the agent Nostr public key without exposing its private key.' ;;
    draft-create) printf '%s\n' 'Usage: buzz-server agents draft-create --community ID --channel UUID --display-name NAME --system-prompt PROMPT' 'Requires BUZZ_PRIVATE_KEY and BUZZ_AUTH_TAG for the requesting agent.' ;;
    draft-update) printf '%s\n' 'Usage: buzz-server agents draft-update --community ID --channel UUID --agent-name NAME [options]' 'Requires BUZZ_PRIVATE_KEY and BUZZ_AUTH_TAG for the requesting agent.' ;;
    archive)      printf '%s\n' 'Usage: sudo buzz-server agents archive --community ID PUBKEY [options]' ;;
    unarchive)    printf '%s\n' 'Usage: sudo buzz-server agents unarchive --community ID PUBKEY [options]' ;;
    archived)     printf '%s\n' 'Usage: sudo buzz-server agents archived --community ID' ;;
    *) return 1 ;;
  esac
}

channels_help() {
  cat <<'EOF_HELP'
Usage: sudo buzz-server channels <command> --community ID [options]

Runs the bundled, Buzz-Server-pinned Buzz channel CLI against the selected
community using the Buzz Server owner identity. Upstream channel commands include
list, get, search, create, update, topic, purpose, join, leave, archive,
unarchive, delete, members, add-member, remove-member, and set-add-policy.
EOF_HELP
}

secrets_help() {
  cat <<'EOF_HELP'
Usage: buzz-server secrets <command> [options]

Commands:
  encrypt             Encrypt a secret with AWS KMS
  decrypt             Decrypt a KMS envelope
  fingerprint         Print a secret fingerprint
  encrypt-passphrase  Encrypt a secret with a passphrase
  decrypt-passphrase  Decrypt a passphrase envelope
  export-nip49        Export a NIP-49 encrypted secret
  import-nip49        Import a NIP-49 encrypted secret
  persist             Persist a secret using the OS-keyring-first local backend
  materialize         Materialize a persisted secret into a restricted file
  clear-local         Remove a locally persisted secret

Run `buzz-server secrets <command> --help` for command-specific help.
EOF_HELP
}

secrets_command_help() {
  case "$1" in
    encrypt)            printf '%s\n' 'Usage: buzz-server secrets encrypt --kms-key-id KEY --input FILE --output FILE [--aws-command PATH]' ;;
    decrypt)            printf '%s\n' 'Usage: buzz-server secrets decrypt --input FILE --output FILE [--aws-command PATH]' ;;
    fingerprint)        printf '%s\n' 'Usage: buzz-server secrets fingerprint --input FILE' ;;
    encrypt-passphrase) printf '%s\n' 'Usage: buzz-server secrets encrypt-passphrase --input FILE --output FILE --passphrase-file FILE' ;;
    decrypt-passphrase) printf '%s\n' 'Usage: buzz-server secrets decrypt-passphrase --input FILE --output FILE --passphrase-file FILE' ;;
    export-nip49)       printf '%s\n' 'Usage: buzz-server secrets export-nip49 --input FILE --output FILE --passphrase-file FILE' ;;
    import-nip49)       printf '%s\n' 'Usage: buzz-server secrets import-nip49 --input FILE --output FILE --passphrase-file FILE' ;;
    persist)            printf '%s\n' 'Usage: buzz-server secrets persist --input FILE --key-file FILE --marker FILE [--service NAME] [--name NAME]' ;;
    materialize)        printf '%s\n' 'Usage: buzz-server secrets materialize --output FILE --key-file FILE --marker FILE [--service NAME] [--name NAME]' ;;
    clear-local)        printf '%s\n' 'Usage: buzz-server secrets clear-local --key-file FILE --marker FILE [--service NAME] [--name NAME]' ;;
    *) return 1 ;;
  esac
}

is_help() {
  [ "${1:-}" = -h ] || [ "${1:-}" = --help ] || [ "${1:-}" = help ]
}

community_relay() {
  "$release/buzz-agentctl" community-relay --community "$1"
}

community_identity_secret() {
  community=$1
  if pubkey=$("$release/buzz-agentctl" community-identity-pubkey --community "$community" 2>/dev/null); then
    secret="/run/buzz-server/community-identities/${pubkey}.secret"
    [ -r "$secret" ] || { echo "Community identity credential is unavailable for $community" >&2; return 77; }
    printf '%s\n' "$secret"
    return 0
  fi
  echo "Community has no associated identity" >&2
  return 77
}

join_community() {
  display_name=
  relay_url=
  secret_file=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --display-name) [ "$#" -ge 2 ] || { communities_command_help join >&2; return 64; }; display_name=$2; shift 2 ;;
      --relay-url) [ "$#" -ge 2 ] || { communities_command_help join >&2; return 64; }; relay_url=$2; shift 2 ;;
      --secret-file) [ "$#" -ge 2 ] || { communities_command_help join >&2; return 64; }; secret_file=$2; shift 2 ;;
      *) communities_command_help join >&2; return 64 ;;
    esac
  done
  [ -n "$display_name" ] && [ -n "$relay_url" ] || { communities_command_help join >&2; return 64; }

  temporary=
  if [ -z "$secret_file" ]; then
    [ -r /dev/tty ] || { echo "No terminal is available; use --secret-file FILE" >&2; return 64; }
    temporary=$(mktemp /run/buzz-server/community-join-secret.XXXXXX)
    chmod 0600 "$temporary"
    printf 'Nostr private key: ' >/dev/tty
    stty -echo </dev/tty
    IFS= read -r secret_value </dev/tty || { stty echo </dev/tty; rm -f "$temporary"; return 1; }
    stty echo </dev/tty
    printf '\n' >/dev/tty
    printf '%s' "$secret_value" >"$temporary"
    unset secret_value
    secret_file=$temporary
  fi

  [ -r "$secret_file" ] || { [ -z "$temporary" ] || rm -f "$temporary"; echo "Cannot read secret file: $secret_file" >&2; return 66; }
  pubkey=$("$release/buzz-secretsctl" public-key --input "$secret_file") || { [ -z "$temporary" ] || rm -f "$temporary"; return 1; }
  custody_root=/var/lib/buzz-server/community-identities
  runtime_root=/run/buzz-server/community-identities
  install -d -o root -g root -m 0700 "$custody_root" "$runtime_root"
  key_file="$custody_root/$pubkey.secret"
  marker="$custody_root/$pubkey.keyring"
  envelope="$custody_root/$pubkey.envelope.json"
  runtime_secret="$runtime_root/$pubkey.secret"
  disposition=existing
  if [ ! -e "$key_file" ] && [ ! -e "$marker" ] && [ ! -e "$envelope" ]; then
    disposition=created
    kms_key_id=$(python3 - /etc/buzz-server/config.json <<'PYKMS'
import json, sys
print(json.load(open(sys.argv[1])).get("identity_custody", {}).get("kms_key_id", ""))
PYKMS
)
    if [ -n "$kms_key_id" ]; then
      "$release/buzz-secretsctl" encrypt --kms-key-id "$kms_key_id" --input "$secret_file" --output "$envelope" || { [ -z "$temporary" ] || rm -f "$temporary"; return 1; }
    else
      "$release/buzz-secretsctl" persist --input "$secret_file" --key-file "$key_file" --marker "$marker" --service buzz-server --name "community-identity:$pubkey" || { [ -z "$temporary" ] || rm -f "$temporary"; return 1; }
    fi
  fi
  if [ -f "$envelope" ]; then
    "$release/buzz-secretsctl" decrypt --input "$envelope" --output "$runtime_secret" || { [ -z "$temporary" ] || rm -f "$temporary"; return 1; }
  else
    "$release/buzz-secretsctl" materialize --output "$runtime_secret" --key-file "$key_file" --marker "$marker" --service buzz-server --name "community-identity:$pubkey" || { [ -z "$temporary" ] || rm -f "$temporary"; return 1; }
  fi
  actual=$("$release/buzz-secretsctl" public-key --input "$runtime_secret") || { [ -z "$temporary" ] || rm -f "$temporary"; return 1; }
  [ "$actual" = "$pubkey" ] || { rm -f "$runtime_secret"; [ -z "$temporary" ] || rm -f "$temporary"; echo "Community identity custody mismatch" >&2; return 65; }
  [ -z "$temporary" ] || rm -f "$temporary"

  if "$release/buzz-agentctl" community-join --display-name "$display_name" --relay-url "$relay_url" --identity-pubkey "$pubkey"; then
    return 0
  else
    status=$?
  fi
  if [ "$disposition" = created ]; then
    "$release/buzz-secretsctl" clear-local --key-file "$key_file" --marker "$marker" --service buzz-server --name "community-identity:$pubkey" || true
    rm -f "$envelope" "$runtime_secret"
  fi
  return "$status"
}

run_owner_buzz() {
  group=$1
  subcommand=$2
  community=$3
  shift 3
  relay_url=$(community_relay "$community")
  owner_secret=$(community_identity_secret "$community") || exit $?
  BUZZ_RELAY_URL=$relay_url BUZZ_PRIVATE_KEY=$(cat "$owner_secret") \
    exec "$release/buzz-cli" "$group" "$subcommand" "$@"
}

run_requester_buzz() {
  subcommand=$1
  community=$2
  shift 2
  relay_url=$(community_relay "$community")
  [ -n "${BUZZ_PRIVATE_KEY:-}" ] && [ -n "${BUZZ_AUTH_TAG:-}" ] || {
    echo "agents $subcommand requires BUZZ_PRIVATE_KEY and BUZZ_AUTH_TAG for the requesting agent" >&2
    exit 77
  }
  BUZZ_RELAY_URL=$relay_url exec "$release/buzz-cli" agents "$subcommand" "$@"
}

command=${1:-}
case "$command" in
  -h|--help|help)
    help
    ;;
  -V|--version|version)
    if is_help "${2:-}"; then
      command_help version
    else
      case "$identity" in
        v[0-9]*) printf 'buzz-server %s\n' "$identity" ;;
        *) printf 'buzz-server build %s\n' "$identity" ;;
      esac
    fi
    ;;
  communities)
    shift
    if is_help "${1:-}" || [ "$#" -eq 0 ]; then
      communities_help
    elif [ "$#" -ge 2 ] && is_help "${2:-}"; then
      communities_command_help "$1" || { communities_help >&2; exit 64; }
    else
      subcommand=$1
      shift
      case "$subcommand" in
        join) join_community "$@" ;;
        get|list|update|delete) exec "$release/buzz-agentctl" "community-$subcommand" "$@" ;;
        *) communities_help >&2; exit 64 ;;
      esac
    fi
    ;;
  personas)
    shift
    if is_help "${1:-}" || [ "$#" -eq 0 ]; then
      personas_help
    elif [ "$#" -ge 2 ] && is_help "${2:-}"; then
      personas_command_help "$1" || { personas_help >&2; exit 64; }
    else
      subcommand=$1
      shift
      case "$subcommand" in
        create|get|list|update|delete) exec "$release/buzz-agentctl" "persona-$subcommand" "$@" ;;
        *) personas_help >&2; exit 64 ;;
      esac
    fi
    ;;
  agents)
    shift
    if is_help "${1:-}" || [ "$#" -eq 0 ]; then
      agents_help
    elif [ "$#" -ge 2 ] && is_help "${2:-}"; then
      agents_command_help "$1" || { agents_help >&2; exit 64; }
    else
      subcommand=$1
      shift
      case "$subcommand" in
        pubkey)
          [ "$#" -eq 2 ] && [ "${1:-}" = --agent ] || { agents_command_help pubkey >&2; exit 64; }
          agent_id=$2
          case "$agent_id" in agent_[A-Za-z0-9]* ) ;; *) echo "invalid agent ID" >&2; exit 64 ;; esac
          case "$agent_id" in *[!A-Za-z0-9_]* ) echo "invalid agent ID" >&2; exit 64 ;; esac
          exec "$release/buzz-secretsctl" public-key --input "/var/lib/buzz-server/identities/${agent_id}.secret"
          ;;
        create|get|list|update|enable|disable|logs|delete|purge|operation)
          exec "$release/buzz-agentctl" "$subcommand" "$@"
          ;;
        draft-create|draft-update)
          [ "${1:-}" = --community ] && [ -n "${2:-}" ] || { agents_command_help "$subcommand" >&2; exit 64; }
          community=$2
          shift 2
          run_requester_buzz "$subcommand" "$community" "$@"
          ;;
        archive|unarchive|archived)
          [ "${1:-}" = --community ] && [ -n "${2:-}" ] || { agents_command_help "$subcommand" >&2; exit 64; }
          community=$2
          shift 2
          run_owner_buzz agents "$subcommand" "$community" "$@"
          ;;
        *) agents_help >&2; exit 64 ;;
      esac
    fi
    ;;
  channels)
    shift
    if is_help "${1:-}" || [ "$#" -eq 0 ]; then
      channels_help
    else
      subcommand=$1
      shift
      [ "${1:-}" = --community ] && [ -n "${2:-}" ] || { channels_help >&2; exit 64; }
      community=$2
      shift 2
      run_owner_buzz channels "$subcommand" "$community" "$@"
    fi
    ;;
  secrets)
    shift
    if is_help "${1:-}" || [ "$#" -eq 0 ]; then
      secrets_help
    elif [ "$#" -ge 2 ] && is_help "${2:-}"; then
      secrets_command_help "$1" || { secrets_help >&2; exit 64; }
    else
      exec "$release/buzz-secretsctl" "$@"
    fi
    ;;
  run|health|check|start|restart|stop|status|redeploy|rollback|backup|restore)
    if is_help "${2:-}"; then
      command_help "$command"
    else
      case "$command" in
        run) shift; exec "$release/buzz-server-daemon" "$@" ;;
        *) exec "$release/share/deploy/buzz-serverctl" "$@" ;;
      esac
    fi
    ;;
  *)
    echo "usage: buzz-server {run|communities|agents|channels|secrets|health|check|start|restart|stop|status|redeploy|rollback|backup|restore|version}" >&2
    exit 64
    ;;
esac
